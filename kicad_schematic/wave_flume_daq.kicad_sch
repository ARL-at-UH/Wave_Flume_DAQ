	)
	(text "POWER (Rail A) - three Class II supplies, all outputs floating: A2 HDR-15-24 -> FA (time-delay) -> V1 bus (GND_24); A4 HDR-15-12 -> FB -> V2 bus (+12 V, GND_12); A3 HDR-15-24 = the Setra's private island -> X1-X2 (GND_24ISO)."
		(exclude_from_sim no)
